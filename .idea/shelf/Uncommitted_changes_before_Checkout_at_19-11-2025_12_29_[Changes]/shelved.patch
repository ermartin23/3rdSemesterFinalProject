+++ b/server/DataAccess/Pricing/ChosenNumbersPackages.cs	(date 1763537247125)
@@ -1,0 +1,24 @@
+using System;
+using System.Collections.Generic;
+
+namespace DataAccess.Pricing
+{
+    public static class ChosenNumbersPackages
+    {
+        private static readonly Dictionary<int, decimal> PriceByChosenNumbers = new()
+        {
+            { 5, 20m },
+            { 10, 35m },
+            { 15, 45m }
+        };
+
+        public static decimal GetPrice(int chosenNumbers)
+        {
+            if (PriceByChosenNumbers.TryGetValue(chosenNumbers, out var price))
+                return price;
+
+            throw new ArgumentOutOfRangeException(nameof(chosenNumbers),
+                $"No price configured for {chosenNumbers} chosen numbers");
+        }
+    }
+}
